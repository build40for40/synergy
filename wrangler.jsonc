{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synergy-api",
  "main": "worker/index.js",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "synergy",
    // Placeholder until `npm run wrangler -- d1 create synergy` is run. Local dev works without it.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  // Daily Dealroom sync at 06:07 UTC, before the morning's leads are picked.
  "triggers": { "crons": ["7 6 * * *"] }
}
