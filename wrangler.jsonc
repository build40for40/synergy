  // .dev.vars switches local dev to the staging client. See worker/auth.js.
  "vars": { "WORKOS_CLIENT_ID": "client_01M6E5ZDQ9XBYYE28XYN7H3XTJ" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "synergy",
    "database_id": "63163cc6-c8cf-4b96-a3e3-361646301b24",
    "migrations_dir": "migrations"
  }]
}
