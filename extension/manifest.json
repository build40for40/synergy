{
  "manifest_version": 3,
  "name": "Synergy",
  "version": "0.0.1",
  "description": "Ten founder leads a day, with what's known and what isn't, and a simple did-you-reach-out loop.",
  "author": "40 for 40",
  "homepage_url": "https://build40for40.com/synergy/",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://synergy-api.40for40.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open today's leads"
  }
}
